etica;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="436" y="1540" width="110" height="44" as="geometry"/></mxCell><mxCell id="lg_comp_ic" value="" style="shape=module;jettyWidth=6;jettyHeight=3;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="528" y="1544" width="12" height="14" as="geometry"/></mxCell><mxCell id="lg_ball" value="" style="ellipse;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#1a1a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="1554" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_prov" style="endArrow=none;html=1;strokeColor=#1a1a1a;strokeWidth=1.5;" edge="1" parent="1" target="lg_ball"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1562" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="lg_req" style="endArrow=halfCircle;endFill=0;endSize=9;targetPerimeterSpacing=3;html=1;strokeColor=#4d4d4d;" edge="1" parent="1" target="lg_ball"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="1562" as="sourcePoint"/></mxGeometry></mxCell><mxCell id="lg_txt1" value="&lt;b&gt;Conector de montagem&lt;/b&gt;: bola = interface &lt;i&gt;fornecida&lt;/i&gt;; soquete = interface &lt;i&gt;requerida&lt;/i&gt;. O rótulo indica a operação ou o evento principal." style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="686" y="1536" width="480" height="52" as="geometry"/></mxCell><mxCell id="lg_txt2" value="&lt;b&gt;«requer» Cn: IX&lt;/b&gt; (compartimento tracejado) = interface requerida de &lt;b&gt;outro subsistema&lt;/b&gt;, resolvida pelo nome da bola correspondente em Cn (ver matriz de integração)." style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="436" y="1596" width="730" height="44" as="geometry"/></mxCell><mxCell id="lg_cM" value="" style="rounded=0;html=1;fillCol
        <mxCell id="y-9E5nLQ_uyiijW86kDa-192" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" value="Modelo integrado&lt;br&gt;&lt;br&gt;Os quatro componentes estão detalhados: serviços do domínio, conteúdo UGC, usuários/canais e reprodução.&lt;br&gt;&lt;br&gt;As classes preservam os identificadores e relacionamentos das versões anteriores, com as revisões de cada responsável." vertex="1">

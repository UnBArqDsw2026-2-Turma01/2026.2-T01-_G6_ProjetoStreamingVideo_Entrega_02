        <mxCell id="y-9E5nLQ_uyiijW86kDa-210" parent="y-9E5nLQ_uyiijW86kDa-209" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=13;" value="+ streamId: UUID&lt;br&gt;+ reason: string&lt;br&gt;+ occurredAt: Date" vertex="1">

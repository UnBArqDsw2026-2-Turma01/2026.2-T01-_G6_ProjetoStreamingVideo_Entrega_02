        <mxCell id="pF4xcbGHGSgx6e3GGPbU-196" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" value="Preenchimento restante&lt;br&gt;&lt;br&gt;Usuários/canais e reprodução mantêm seus campos a preencher.&lt;br&gt;&lt;br&gt;O pacote de conteúdo e os contratos de clipagem foram revisados. As classes preservam seus identificadores e relacionamentos." vertex="1">
          <mxGeometry height="230" width="360" x="-32" y="792" as="geometry" />
        </mxCell>
        <mxCell id="pF4xcbGHGSgx6e3GGPbU-197" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" value="Fluxo assíncrono de clipagem&lt;br&gt;&lt;br&gt;1. finishStream devolve RecordingHandle opcional.&lt;br&gt;2. A solicitação é persistida via ClipRequestRepository.&lt;br&gt;3. RecordingAvailable libera a extração.&lt;br&gt;4. RecordingFailed encerra pedidos pendentes.&lt;br&gt;5. ClipService conclui cada requestId no máximo uma vez." vertex="1">
          <mxGeometry height="250" width="360" x="-32" y="1052" as="geometry" />
        </mxCell>
        <mxCell id="pF4xcbGHGSgx6e3GGPbU-198" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;" value="Legenda:&#10;&#10;Laranja - servicos do dominio&#10;Cinza - interfaces e contratos&#10;Azul - value objects, eventos e enums (entradas e saidas)&#10;Branco com borda roxa - classes a preencher&#10;Seta tracejada - dependencia (use / create)" vertex="1">
          <mxGeometry height="200" width="360" x="-32" y="1332" as="geometry" />
        </mxCell>
      <mxCell id="ugc-ContentVisibility" value="«enumeration»&lt;br&gt;&lt;b&gt;ContentVisibility&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="2290" y="-20" width="400" height="124" /></mxCell><mxCell id="ugc-ContentVisibility-values" value="PUBLIC&lt;br&gt;UNLISTED&lt;br&gt;PRIVATE" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="ugc-ContentVisibility"><mxGeometry as="geometry" x="0" y="40" width="400" height="84" /></mxCell><mxCell id="ugc-PublicationStatus" value="«enumeration»&lt;br&gt;&lt;b&gt;PublicationStatus&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="2290" y="130" width="400" height="100" /></mxCell><mxCell id="ugc-PublicationStatus-values" value="UNPUBLISHED&lt;br&gt;PUBLISHED" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="ugc-PublicationStatus"><mxGeometry as="geometry" x="0" y="40" width="400" height="60" /></mxCell><mxCell id="ugc-LiveStreamStatus" value="«enumeration»&lt;br&gt;&lt;b&gt;LiveStreamStatus&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="2290" y="260" width="400" height="148" /></mxCell><mxCell id="ugc-LiveStreamStatus-values" value="CREATED&lt;br&gt;LIVE&lt;br&gt;ENDED&lt;br&gt;FAILED" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="ugc-LiveStreamStatus"><mxGeometry as="geometry" x="0" y="40" width="400" height="108" /></mxCell><mxCell id="ugc-LatencyMode" value="«enumeration»&lt;br&gt;&lt;b&gt;LatencyMode&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="2290" y="440" width="400" height="124" /></mxCell><mxCell id="ugc-LatencyMode-values" value="STANDARD&lt;br&gt;LOW&lt;br&gt;ULTRA_LOW" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="ugc-LatencyMode"><mxGeometry as="geometry" x="0" y="40" width="400" height="84" /></mxCell><mxCell id="ugc-ProcessingStatus" value="«enumeration»&lt;br&gt;&lt;b&gt;ProcessingStatus&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="2290" y="590" width="400" height="124" /></mxCell><mxCell id="ugc-ProcessingStatus-values" value="PROCESSING&lt;br&gt;READY&lt;br&gt;FAILED" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="ugc-ProcessingStatus"><mxGeometry as="geometry" x="0" y="40" width="400" height="84" /></mxCell><mxCell id="ugc-ClipRequestStatus" value="«enumeration»&lt;br&gt;&lt;b&gt;ClipRequestStatus&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="2290" y="740" width="400" height="172" /></mxCell><mxCell id="ugc-ClipRequestStatus-values" value="WAITING_RECORDING&lt;br&gt;PROCESSING&lt;br&gt;COMPLETED&lt;br&gt;FAILED&lt;br&gt;REJECTED" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="ugc-ClipRequestStatus"><mxGeometry as="geometry" x="0" y="40" width="400" height="132" /></mxCell><mxCell id="ugc-onRecordingFailed" value="+ onRecordingFailed(event: RecordingFailed): void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="pF4xcbGHGSgx6e3GGPbU-36"><mxGeometry as="geometry" x="0" y="274" width="367" height="26" /></mxCell><mxCell id="ugc-ClipRequestRepository" value="«interface»&lt;br&gt;&lt;b&gt;ClipRequestRepository&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="1450" width="470" height="200" /></mxCell><mxCell id="ugc-ClipRequestRepository-methods" value="+ save(request: ClipRequest): void&lt;br&gt;+ findById(requestId: UUID): ClipRequest [0..1]&lt;br&gt;+ findWaitingByStream(streamId: UUID): ClipRequest [0..*]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="ugc-ClipRequestRepository"><mxGeometry as="geometry" x="0" y="40" width="470" height="152" /></mxCell><mxCell id="ugc-RecordingFailed" value="«event»&lt;br&gt;&lt;b&gt;RecordingFailed&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry as="geometry" x="2290" y="960" width="400" height="148" /></mxCell><mxCell id="ugc-RecordingFailed-fields" value="+ streamId: UUID&lt;br&gt;+ reason: string&lt;br&gt;+ occurredAt: Date" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="ugc-RecordingFailed"><mxGeometry as="geometry" x="0" y="40" width="400" height="108" /></mxCell><mxCell id="ugc-service-requests" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;jumpStyle=arc;fontSize=12;dashed=1;" edge="1" parent="1" source="pF4xcbGHGSgx6e3GGPbU-36" target="ugc-ClipRequestRepository"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="455" y="1080" /><mxPoint x="455" y="1530" /></Array></mxGeometry></mxCell><mxCell id="ugc-repo-request" value="persiste" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;jumpStyle=arc;fontSize=12;dashed=1;" edge="1" parent="1" source="ugc-ClipRequestRepository" target="pF4xcbGHGSgx6e3GGPbU-116"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1530" y="1550" /><mxPoint x="1530" y="1690" /></Array></mxGeometry></mxCell><mxCell id="ugc-rules" value="Regras do fluxo de clipes&lt;br&gt;&lt;br&gt;1. A solicitação pode ocorrer durante a live; a extração aguarda RecordingAvailable e vídeo READY.&lt;br&gt;&lt;br&gt;2. Sem gravação habilitada: rejeitar a solicitação. finishStream retorna vazio se nenhuma gravação for iniciada.&lt;br&gt;&lt;br&gt;3. RecordingFailed encerra as solicitações pendentes como FAILED, com motivo.&lt;br&gt;&lt;br&gt;4. Validar 0 ≤ início &amp;lt; fim na solicitação. Antes do corte, validar fim ≤ duração do vídeo READY.&lt;br&gt;&lt;br&gt;5. /durationSeconds = endOffsetSeconds − startOffsetSeconds (intervalo solicitado).&lt;br&gt;&lt;br&gt;6. Processamento idempotente por requestId: cada solicitação produz no máximo um Clip.&lt;br&gt;&lt;br&gt;7. ownerId identifica o usuário proprietário do conteúdo. No clipe, createdByUserId identifica quem solicitou o corte; preservar o proprietário da origem.&lt;br&gt;&lt;br&gt;8. publish exige moderação APPROVED e mídia pronta. Publicação não substitui autorização de acesso.&lt;br&gt;&lt;br&gt;9. READY exige duração, storageUri, availableAt e manifesto disponíveis. Emitir RecordingAvailable após a persistência.&lt;br&gt;&lt;br&gt;10. ClipRequest guarda o pedido; ClipService coordena a extração via MediaProcessingService e conclui a solicitação." style="shape=note;whiteSpace=wrap;html=1;size=16;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="2290" y="1140" width="410" height="780" /></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>
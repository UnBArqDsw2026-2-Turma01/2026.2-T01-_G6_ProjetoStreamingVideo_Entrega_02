nds)&lt;br&gt;&lt;span style=&quot;color:#b8860b;font-size:9px&quot;&gt;&amp;#9679; DE10&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="TK_VALID" target="TK_EXP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t26" value="renewToken() [sessão ativa]&lt;br&gt;&lt;span style=&quot;color:#b8860b;font-size:9px&quot;&gt;&amp;#9679; DE10&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="TK_EXP" target="TK_VALID"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="800"/><mxPoint x="290" y="800"/></Array></mxGeometry></mxCell><mxCell id="t27" value="sessão encerrada&lt;br&gt;&lt;span style=&quot;color:#b8860b;font-size:9px&quot;&gt;&amp;#9679; DE10&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="TK_EXP" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ev_tbl" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Evidências que sustentam esta máquina&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:90px&quot;&gt;Evidência&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:130px&quot;&gt;Tipo&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:300px&quot;&gt;O que comprova&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:230px&quot;&gt;Onde aparece no diagrama&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Segmentos têm duração-alvo e número de sequência (RFC 8216)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;PLAYING ⇄ BUFFERING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E12&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Media playlist real capturada no navegador&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;chegada do próximo segmento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Variantes de qualidade são normatizadas&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;troca de variante (ABR) em PLAYING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;DE10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#b8860b&quot;&gt;&amp;#9679;&lt;/span&gt; decisão de projeto&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;PlaybackToken e PlaybackSession são decisão de projeto declarada&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;toda a região 2 e as guardas de autorização&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;spacing=10;" vertex="1" parent="1"><mxGeometry x="1340" y="0" width="800" height="160" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1340" y="200" width="800" height="250" as="geometry"/></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legenda — notação UML 2.5 (Máquina de Estados)&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="1354" y="208" width="500" height="22" as="geometry"/></mxCell><mxCell id="lg_init" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1362" y="244" width="18" height="18" as="geometry"/></mxCell><mxCell id="lg_init_t" value="pseudoestado inicial" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1388" y="240" width="170" height="26" as="geometry"/></mxCell><mxCell id="lg_fin" value="" style="ellipse;html=1;fillColor=none;strokeColor=#1a1a1a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1572" y="240" width="26" height="26" as="geometry"/></mxCell><mxCell id="lg_fin_i" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1578" y="246" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg_fin_t" value="estado final" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1606" y="240" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_ch" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1750" y="238" width="30" height="30" as="geometry"/></mxCell><mxCell id="lg_ch_t" value="escolha (guardas)" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1786" y="240" width="160" height="26" as="geometry"/></mxCell><mxCell id="lg_st" value="&lt;b style=&quot;font-size:12px&quot;&gt;ESTADO&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #666;margin:3px 6px 0 6px;padding-top:2px;font-size:9px;text-align:left&quot;&gt;entry / do / exit&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1362" y="288" width="150" height="56" as="geometry"/></mxCell><mxCell id="lg_st_t" value="Estado com comportamento interno. A transição é rotulada &lt;i&gt;gatilho [guarda] / efeito&lt;/i&gt;; &lt;i&gt;after(t)&lt;/i&gt; é evento de tempo." style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1526" y="284" width="600" height="62" as="geometry"/></mxCell><mxCell id="lg_ev" value="&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; &lt;b&gt;E&lt;i&gt;n&lt;/i&gt;&lt;/b&gt; = transição sustentada por &lt;b&gt;evidência observada&lt;/b&gt; &amp;nbsp;·&amp;nbsp; &lt;span style=&quot;color:#b8860b&quot;&gt;&amp;#9679;&lt;/span&gt; &lt;b&gt;E&lt;i&gt;n&lt;/i&gt;&lt;/b&gt; = &lt;b&gt;decisão de projeto&lt;/b&gt; declarada. F01/F02 = página de evidências do FOCO_01 / FOCO_02; R&lt;i&gt;n&lt;/i&gt; = regra do .drawio do modelo estático." style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1362" y="356" width="756" height="56" as="geometry"/></mxCell><mxCell id="lg_cM" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1362" y="416" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tM" value="M1 · Matheus" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1384" y="411" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cP" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1512" y="416" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tP" value="M2 · Pedro" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1534" y="411" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cH" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1662" y="416" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tH" value="M3 · Heitor" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1684" y="411" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cL" value="" style="rounded=0;html=1;fillColor=#ffe6cc;stro
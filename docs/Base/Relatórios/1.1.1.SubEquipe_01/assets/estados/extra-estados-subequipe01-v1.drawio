uinas&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:260px&quot;&gt;Sinal / guarda&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:200px&quot;&gt;Origem&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:200px&quot;&gt;Destino&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:120px&quot;&gt;Evidência&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;StreamOnline&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M4 · LIVE&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M1 · CH_LIVE&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;F02-E4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;StreamOffline&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M4 · ENDED&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M1 · CH_OFF&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;F02-E4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;RecordingAvailable&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M4 · REC_READY&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M2 · WAIT&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;F01-E5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;RecordingFailed&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M4 · REC_FAIL&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M2 · WAIT&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;R3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;checkCreatorEligibility() = false bloqueia createStream&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M1 · SUSP&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M4 (máquina inteira)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;F02-E9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;clipe publicado fica reproduzível&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M2 · PUB&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;M3 · AUTHZ&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;F01-E13&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="2200" width="820" height="212" as="geometry"/></mxCell><mxCell id="ev_tbl" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Matriz evidência → estado / transição&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:90px&quot;&gt;Evidência&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:80px&quot;&gt;Máquina&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:330px&quot;&gt;O que comprova&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:260px&quot;&gt;Onde aparece&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;padding:0 3px&quot;&gt;M1&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Usuário e criador são papéis distintos (broadcaster_type)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;NOT_ELIGIBLE → ELIGIBLE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;padding:0 3px&quot;&gt;M1&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; O canal é entidade própria e tem isLive&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Channel OFFLINE ⇄ LIVE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E7&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;padding:0 3px&quot;&gt;M1&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; A credencial de ingestão é emitida pelo servidor&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;issueStreamKey() → ACTIVE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E2&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;padding:0 3px&quot;&gt;M1&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; A credencial vem no retorno do setup da transmissão&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;entrada da região 2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;padding:0 3px&quot;&gt;M1&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Notificação assíncrona stream.online&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;gatilho StreamOnline/StreamOffline&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;padding:0 3px&quot;&gt;M1&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Elegibilidade do criador: suspensão e processo de appeals&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;ELIGIBLE ⇄ SUSPENDED → final&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;DE-proj&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;padding:0 3px&quot;&gt;M1&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#b8860b&quot;&gt;&amp;#9679;&lt;/span&gt; TTL e rotação da stream key não são observáveis&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;EXPIRED / REVOKED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;M2&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Criar clipe é assíncrono; após 60 s sem retorno, assuma falha&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;WAITING_RECORDING, after(60 s) → FAILED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;M2&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; O vod_offset só existe depois da gravação (atraso de minutos)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;WAITING_RECORDING → PROCESSING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;M2&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Moderação tem veredito ternário (review / ALLOW / DENY)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;PENDING → APPROVED | REJECTED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E13&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;M2&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; A gravação é a fonte dos clipes&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;origem do pedido de recorte&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;R1 · R9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;M2&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Regras do .drawio: extração exige vídeo READY e manifesto&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;guarda da transição para PROCESSING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;R2 · R4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;M2&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Regras do .drawio: validar 0 ≤ início &lt; fim; sem gravação, rejeitar&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;guardas do pseudoestado de escolha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;R3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;M2&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Regra do .drawio: RecordingFailed encerra pendentes como FAILED&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;WAITING_RECORDING → FAILED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;R8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:0 3px&quot;&gt;M2&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Regra do .drawio: publish exige moderação APPROVED e mídia pronta&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;UNPUBLISHED → PUBLISHED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px&quot;&gt;M3&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Segmentos têm duração-alvo e número de sequência (RFC 8216)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;PLAYING ⇄ BUFFERING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E12&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px&quot;&gt;M3&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Media playlist real capturada no navegador&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;chegada do próximo segmento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px&quot;&gt;M3&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Variantes de qualidade são normatizadas&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;troca de variante (ABR) em PLAYING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;DE10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:0 3px&quot;&gt;M3&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#b8860b&quot;&gt;&amp;#9679;&lt;/span&gt; PlaybackToken e PlaybackSession são decisão de projeto declarada&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;toda a região 2 e as guardas de autorização&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E6&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;M4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; A transmissão tem estado e marco temporal (type, started_at)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;LIVE → ENDED, startedAt/endedAt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;M4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; A gravação aponta para a live que a originou (stream_id)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;ENDED → PROCESSING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;M4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Disponibilidade tardia da gravação&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;PROCESSING → READY&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E13&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;M4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; VOD tem retenção de 7 / 14 / 60 dias&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;READY → EXPIRED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;M4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; A ingestão autoriza e registra o stream antes do pipeline&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;CREATED → FAILED por credencial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;M4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Elegibilidade verificada antes de qualquer mídia&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;guarda de createStream&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;M4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; O estado LIVE e o startedAt&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;CREATED → LIVE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;DM02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;M4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Decisão do FOCO_02: go-live no firstSegmentAvailable&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;gatilho de CREATED → LIVE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;M4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#b8860b&quot;&gt;&amp;#9679;&lt;/span&gt; Moderação em tempo real é analogia, não observação&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;LIVE → FAILED por política&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;R3 · R9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:0 3px&quot;&gt;M4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; Regras do .drawio sobre RecordingAvailable/Failed&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;transições da região 2&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;spacing=10;" vertex="1" parent="1"><mxGeometry x="900" y="2200" width="1000" height="810" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1960" y="2200" width="800" height="250" as="geometry"/></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legenda — notação UML 2.5 (Máquina de Estados)&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="1974" y="2208" width="500" height="22" as="geometry"/></mxCell><mxCell id="lg_init" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1982" y="2244" width="18" height="18" as="geometry"/></mxCell><mxCell id="lg_init_t" value="pseudoestado inicial" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2008" y="2240" width="170" height="26" as="geometry"/></mxCell><mxCell id="lg_fin" value="" style="ellipse;html=1;fillColor=none;strokeColor=#1a1a1a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2192" y="2240" width="26" height="26" as="geometry"/></mxCell><mxCell id="lg_fin_i" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2198" y="2246" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg_fin_t" value="estado final" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2226" y="2240" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_ch" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="2370" y="2238" width="30" height="30" as="geometry"/></mxCell><mxCell id="lg_ch_t" value="escolha (guardas)" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2406" y="2240" width="160" height="26" as="geometry"/></mxCell><mxCell id="lg_st" value="&lt;b style=&quot;font-size:12px&quot;&gt;ESTADO&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #666;margin:3px 6px 0 6px;padding-top:2px;font-size:9px;text-align:left&quot;&gt;entry / do / exit&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1982" y="2288" width="150" height="56" as="geometry"/></mxCell><mxCell id="lg_st_t" value="Estado com comportamento interno. A transição é rotulada &lt;i&gt;gatilho [guarda] / efeito&lt;/i&gt;; &lt;i&gt;after(t)&lt;/i&gt; é evento de tempo." style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2146" y="2284" width="600" height="62" as="geometry"/></mxCell><mxCell id="lg_ev" value="&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; &lt;b&gt;E&lt;i&gt;n&lt;/i&gt;&lt;/b&gt; = transição sustentada por &lt;b&gt;evidência observada&lt;/b&gt; &amp;nbsp;·&amp;nbsp; &lt;span style=&quot;color:#b8860b&quot;&gt;&amp;#9679;&lt;/span&gt; &lt;b&gt;E&lt;i&gt;n&lt;/i&gt;&lt;/b&gt; = &lt;b&gt;decisão de projeto&lt;/b&gt; declarada. F01/F02 = página de evidências do FOCO_01 / FOCO_02; R&lt;i&gt;n&lt;/i&gt; = regra do .drawio do modelo estático." style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1982" y="2356" width="756" height="56" as="geometry"/></mxCell><mxCell id="lg_cM" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1982" y="2416" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tM" value="M1 · Matheus" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2004" y="2411" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cP" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="2132" y="2416" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tP" value="M2 · Pedro" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2154" y="2411" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cH" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2282" y="2416" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tH" value="M3 · Heitor" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2304" y="2411" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cL" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="2432" y="2416" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tL" value="M4 · Lucas" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2454" y="2411" width="130" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
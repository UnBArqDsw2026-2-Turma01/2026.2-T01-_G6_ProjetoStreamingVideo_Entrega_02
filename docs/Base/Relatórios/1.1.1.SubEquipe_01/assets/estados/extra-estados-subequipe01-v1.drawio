ometry x="1250" y="686" width="28" height="28" as="geometry"/></mxCell><mxCell id="b1_in" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1256" y="692" width="16" height="16" as="geometry"/></mxCell><mxCell id="nB" value="A retenção de 7/14/60 dias conforme o tipo de criador está no artigo de VOD da plataforma (E13): é o que torna EXPIRED um estado real, e não hipótese." style="shape=note;whiteSpace=wrap;html=1;fontFamily=Helvetica;size=14;fillColor=#ffffe6;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="770" width="350" height="115" as="geometry"/></mxCell><mxCell id="t7" value="createStream(userId, config)&lt;br&gt;[checkCreatorEligibility()]&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; F02-E9&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a0" target="CREATED"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="150" y="0"/></mxGeometry></mxCell><mxCell id="t8" value="firstSegmentAvailable&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; F02-E11&lt;/span&gt; &lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; DM02&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="CREATED" target="LIVE"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t9" value="finishStream()&lt;br&gt;&lt;span style=&quot;co
="0"/></mxGeometry></mxCell><mxCell id="t9" value="[fim ≤ início] ou&lt;br&gt;[live sem gravação]&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; R2·R4&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ch" target="REJ"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="172" y="485"/></Array></mxGeometry></mxCell><mxCell id="t10" value="[0 ≤ início &amp;lt; fim]&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; F01-E4&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="ch" target="WAIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t11" value="RecordingAvailable&lt;br&gt;[vídeo READY ∧ fim ≤ duração]&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; F01-E5&lt;/span&gt; &lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; R1·R9&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="WAIT" target="PROC"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-52"/></mxGeometry></mxCell><mxCell id="t12" value="clipe extraído&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; F01-E4&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="PROC" target="DONE"><mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-52"/></mxGeometry></mxCell><mxCell id="t13" value="RecordingFailed(reason)&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; R3&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="WAIT" target="FAIL"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="234"/><mxPoint x="640" y="485"/></Array></mxGeometry></mxCell><mxCell id="t14" value="after(60 s) / fail(&amp;quot;timeout&amp;quot;)&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; F01-E4&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="PROC" target="FAIL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="m0" target="MOD_PEND"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t24" value="ALLOW&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; F01-E8&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="MOD_PEND" target="MOD_OK"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t25" value="DENY&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; F01-E8&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="MOD_PEND" target="MOD_NO"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="792"/><mxPoint x="980" y="792"/></Array></mxGeometry></mxCell><mxCell id="t26" value="DENY posterior&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; F01-E8&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="MOD_OK" target="MOD_NO"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="p0" target="UNPUB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t31" value="publish() [moderação = APPROVED ∧ mídia pronta]&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; R8&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;" edge="1" parent="1" source="UNPUB" target="PUB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t32" value="unpublish()  /  DENY da moderação&lt;br&gt;&lt;span style=&quot;color:#2e7d32;font-size:9px&quot;&gt;&amp;#9679; F01-E8&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#333333;strokeWidth=1.2;fontFamily=Helvetica;fontSize=10;fontColor=#222222;labelBackgroundColor=#ffffff;verticalAlign=middle;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="PUB" target="UNPUB"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="922"/><mxPoint x="270" y="922"/></Array></mxGeometry></mxCell><mxCell id="ev_tbl" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Evidências que sustentam esta máquina&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:90px&quot;&gt;Evidência&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:130px&quot;&gt;Tipo&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:300px&quot;&gt;O que comprova&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:230px&quot;&gt;Onde aparece no diagrama&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Criar clipe é assíncrono; após 60 s sem retorno, assuma falha&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;WAITING_RECORDING, after(60 s) → FAILED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;O vod_offset só existe depois da gravação (atraso de minutos)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;WAITING_RECORDING → PROCESSING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Moderação tem veredito ternário (review / ALLOW / DENY)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;PENDING → APPROVED | REJECTED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E13&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;A gravação é a fonte dos clipes&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;origem do pedido de recorte&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;R1 · R9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Regras do .drawio: extração exige vídeo READY e manifesto&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;guarda da transição para PROCESSING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;R2 · R4&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Regras do .drawio: validar 0 ≤ início &lt; fim; sem gravação, rejeitar&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;guardas do pseudoestado de escolha&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;R3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Regra do .drawio: RecordingFailed encerra pendentes como FAILED&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;WAITING_RECORDING → FAILED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;R8&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Regra do .drawio: publish exige moderação APPROVED e mídia pronta&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;UNPUBLISHED → PUBLISHED&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;spacing=10;" vertex="1" parent="1"><mxGeometry x="1340" y="0" width="800" height="264" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1340" y="304" width="800" height="250" as="geometry"/></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legenda — notação UML 2.5 (Máquina de Estados)&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="1354" y="312" width="500" height="22" as="geometry"/></mxCell><mxCell id="lg_init" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1362" y="348" width="18" height="18" as="geometry"/></mxCell><mxCell id="lg_init_t" value="pseudoestado inicial" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1388" y="344" width="170" height="26" as="geometry"/></mxCell><mxCell id="lg_fin" value="" style="ellipse;html=1;fillColor=none;strokeColor=#1a1a1a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1572" y="344" width="26" height="26" as="geometry"/></mxCell><mxCell id="lg_fin_i" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1578" y="350" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg_fin_t" value="estado final" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1606" y="344" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_ch" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1750" y="342" width="30" height="30" as="geometry"/></mxCell><mxCell id="lg_ch_t" value="escolha (guardas)" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1786" y="344" width="160" height="26" as="geometry"/></mxCell><mxCell id="lg_st" value="&lt;b style=&quot;font-size:12px&quot;&gt;ESTADO&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #666;margin:3px 6px 0 6px;padding-top:2px;font-size:9px;text-align:left&quot;&gt;entry / do / exit&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1362" y="392" width="150" height="56" as="geometry"/></mxCell><mxCell id="lg_st_t" value="Estado com comportamento interno. A transição é rotulada &lt;i&gt;gatilho [guarda] / efeito&lt;/i&gt;; &lt;i&gt;after(t)&lt;/i&gt; é evento de tempo." style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1526" y="388" width="600" height="62" as="geometry"/></mxCell><mxCell id="lg_ev" value="&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; &lt;b&gt;E&lt;i&gt;n&lt;/i&gt;&lt;/b&gt; = transição sustentada por &lt;b&gt;evidência observada&lt;/b&gt; &amp;nbsp;·&amp;nbsp; &lt;span style=&quot;color:#b8860b&quot;&gt;&amp;#9679;&lt;/span&gt; &lt;b&gt;E&lt;i&gt;n&lt;/i&gt;&lt;/b&gt; = &lt;b&gt;decisão de projeto&lt;/b&gt; declarada. F01/F02 = página de evidências do FOCO_01 / FOCO_02; R&lt;i&gt;n&lt;/i&gt; = regra do .drawio do modelo estático." style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1362" y="460" width="756" height="56" as="geometry"/></mxCell><mxCell id="lg_cM" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1362" y="520" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tM" value="M1 · Matheus" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1384" y="515" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cP" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1512" y="520" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tP" value="M2 · Pedro" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1534" y="515" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cH" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1662" y="520" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tH" value="M3 · Heitor" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1684" y="515" width="130" height="2
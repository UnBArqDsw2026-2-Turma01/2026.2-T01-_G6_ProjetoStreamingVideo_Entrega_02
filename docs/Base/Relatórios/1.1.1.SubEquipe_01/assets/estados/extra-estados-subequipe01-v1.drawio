r invalidada&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="470" width="220" height="78" as="geometry"/></mxCell><mxCell id="rC" value="&lt;b&gt;Região 3 — Channel (o canal existe e é consultável mesmo sem live)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1240" height="230" as="geometry"/></mxCell><mxCell id="c0" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="80" y="805" width="20" height="20" as="geometry"/></mxCell><mxCell id="CH_OFF" value="&lt;b style=&quot;font-size:13px&quot;&gt;OFFLINE&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #9673a6;margin:4px 6px 0 6px;padding-top:3px;font-size:10px;text-align:left;line-height:13px&quot;&gt;isLive = false&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="775" width="230" height="64" as="geometry"/></mxCell><mxCell id="CH_LIVE" value="&lt;b style=&quot;font-size:13px&quot;&gt;LIVE&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #9673a6;margin:4px 6px 0 6px;padding-top:3px;font-size:10px;text-align:left;line-height:13px&quot;&gt;isLive = true&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="580" y="775" width="230" height="64" as="geometry"/></mxCell><mxCell id="nC" value="O canal nunca é destruído pelo
l" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Evidências que sustentam esta máquina&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;width:100%;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:90px&quot;&gt;Evidência&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:130px&quot;&gt;Tipo&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:300px&quot;&gt;O que comprova&lt;/th&gt;&lt;th style=&quot;text-align:left;padding:4px 6px;background:#eeeeee;border-bottom:1px solid #999;width:230px&quot;&gt;Onde aparece no diagrama&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E6&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;A transmissão tem estado e marco temporal (type, started_at)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;LIVE → ENDED, startedAt/endedAt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E3&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;A gravação aponta para a live que a originou (stream_id)&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;ENDED → PROCESSING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E5&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Disponibilidade tardia da gravação&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;PROCESSING → READY&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F01-E13&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;VOD tem retenção de 7 / 14 / 60 dias&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;READY → EXPIRED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E1&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;A ingestão autoriza e registra o stream antes do pipeline&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;CREATED → FAILED por credencial&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Elegibilidade verificada antes de qualquer mídia&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;guarda de createStream&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;O estado LIVE e o startedAt&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;CREATED → LIVE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;DM02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Decisão do FOCO_02: go-live no firstSegmentAvailable&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;gatilho de CREATED → LIVE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;F02-E10&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#b8860b&quot;&gt;&amp;#9679;&lt;/span&gt; decisão de projeto&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Moderação em tempo real é analogia, não observação&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;LIVE → FAILED por política&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;b&gt;R3 · R9&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; observado&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;Regras do .drawio sobre RecordingAvailable/Failed&lt;/td&gt;&lt;td style=&quot;padding:3px 6px;border-bottom:1px solid #e3e3e3;vertical-align:top&quot;&gt;transições da região 2&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;spacing=10;" vertex="1" parent="1"><mxGeometry x="1340" y="0" width="800" height="316" as="geometry"/></mxCell><mxCell id="legend" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1340" y="356" width="800" height="250" as="geometry"/></mxCell><mxCell id="legend_t" value="&lt;b&gt;Legenda — notação UML 2.5 (Máquina de Estados)&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry x="1354" y="364" width="500" height="22" as="geometry"/></mxCell><mxCell id="lg_init" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1362" y="400" width="18" height="18" as="geometry"/></mxCell><mxCell id="lg_init_t" value="pseudoestado inicial" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1388" y="396" width="170" height="26" as="geometry"/></mxCell><mxCell id="lg_fin" value="" style="ellipse;html=1;fillColor=none;strokeColor=#1a1a1a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1572" y="396" width="26" height="26" as="geometry"/></mxCell><mxCell id="lg_fin_i" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1578" y="402" width="14" height="14" as="geometry"/></mxCell><mxCell id="lg_fin_t" value="estado final" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1606" y="396" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_ch" value="" style="rhombus;html=1;fillColor=#ffffff;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1750" y="394" width="30" height="30" as="geometry"/></mxCell><mxCell id="lg_ch_t" value="escolha (guardas)" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1786" y="396" width="160" height="26" as="geometry"/></mxCell><mxCell id="lg_st" value="&lt;b style=&quot;font-size:12px&quot;&gt;ESTADO&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #666;margin:3px 6px 0 6px;padding-top:2px;font-size:9px;text-align:left&quot;&gt;entry / do / exit&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1362" y="444" width="150" height="56" as="geometry"/></mxCell><mxCell id="lg_st_t" value="Estado com comportamento interno. A transição é rotulada &lt;i&gt;gatilho [guarda] / efeito&lt;/i&gt;; &lt;i&gt;after(t)&lt;/i&gt; é evento de tempo." style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1526" y="440" width="600" height="62" as="geometry"/></mxCell><mxCell id="lg_ev" value="&lt;span style=&quot;color:#2e7d32&quot;&gt;&amp;#9679;&lt;/span&gt; &lt;b&gt;E&lt;i&gt;n&lt;/i&gt;&lt;/b&gt; = transição sustentada por &lt;b&gt;evidência observada&lt;/b&gt; &amp;nbsp;·&amp;nbsp; &lt;span style=&quot;color:#b8860b&quot;&gt;&amp;#9679;&lt;/span&gt; &lt;b&gt;E&lt;i&gt;n&lt;/i&gt;&lt;/b&gt; = &lt;b&gt;decisão de projeto&lt;/b&gt; declarada. F01/F02 = página de evidências do FOCO_01 / FOCO_02; R&lt;i&gt;n&lt;/i&gt; = regra do .drawio do modelo estático." style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1362" y="512" width="756" height="56" as="geometry"/></mxCell><mxCell id="lg_cM" value="" style="rounded=0;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1362" y="572" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tM" value="M1 · Matheus" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1384" y="567" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cP" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1512" y="572" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tP" value="M2 · Pedro" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1534" y="567" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cH" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1662" y="572" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tH" value="M3 · Heitor" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1684" y="567" width="130" height="26" as="geometry"/></mxCell><mxCell id="lg_cL" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1812" y="572" width="16" height="16" as="geometry"/></mxCell><mxCell id="lg_tL" value="M4 · Lucas" style="text;html=1;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1834" y="567" width="130" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="est-consolidado" name="5 · Consolidado — SubEquipe_01"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:24px&quot;&gt;Diagrama de Máquina de Estados — SubEquipe_01 · Transmissão ao vivo, UGC, VOD e Clipagem&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#555555&quot;&gt;Visão consolidada (integração de M1–M4 pelos sinais de domínio) · G6 Streaming de Vídeo · Entrega 02 · v1.0 (17/09/2026) · Heitor M. Ricardo · Lucas A. Zanetti · Matheus L. Amaral · Pedro D. M. Reis&lt;/font&gt;" style="text;html=1;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="-70" width="1700" height="80" as="geometry"/></mxCell><mxCell id="frame_L" value="&lt;font style=&quot;font-size:11px&quot;&gt;«state machine»&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:16px&quot;&gt;M4 · Transmissão ao vivo e gravação (VOD)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Responsável: Lucas Andrade Zanetti (@Bappoz)&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;spacingTop=4;fillColor=#fffaf4;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1300" height="1040" as="geometry"/></mxCell><mxCell id="L_rA" value="&lt;b&gt;Região 1 — LiveStream (enum LiveStreamStatus)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1240" height="430" as="geometry"/></mxCell><mxCell id="L_a0" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="75" y="235" width="20" height="20" as="geometry"/></mxCell><mxCell id="L_CREATED" value="&lt;b style=&quot;font-size:13px&quot;&gt;CREATED&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #d79b00;margin:4px 6px 0 6px;padding-top:3px;font-size:10px;text-align:left;line-height:13px&quot;&gt;entry / persiste stream + credenciais&lt;br&gt;(CONFIGURING no diagrama de sequência)&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140" y="200" width="290" height="80" as="geometry"/></mxCell><mxCell id="L_LIVE" value="&lt;b style=&quot;font-size:13px&quot;&gt;LIVE&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #d79b00;margin:4px 6px 0 6px;padding-top:3px;font-size:10px;text-align:left;line-height:13px&quot;&gt;entry / startedAt := now&lt;br&gt;entry / publica StreamOnline&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="250" height="80" as="geometry"/></mxCell><mxCell id="L_ENDED" value="&lt;b style=&quot;font-size:13px&quot;&gt;ENDED&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #d79b00;margin:4px 6px 0 6px;padding-top:3px;font-size:10px;text-align:left;line-height:13px&quot;&gt;entry / endedAt := now&lt;br&gt;entry / publica StreamOffline&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="920" y="200" width="250" height="80" as="geometry"/></mxCell><mxCell id="L_FAILED" value="&lt;b style=&quot;font-size:13px&quot;&gt;FAILED&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #d79b00;margin:4px 6px 0 6px;padding-top:3px;font-size:10px;text-align:left;line-height:13px&quot;&gt;entry / fail(reason)&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="410" width="250" height="64" as="geometry"/></mxCell><mxCell id="L_a1" value="" style="ellipse;html=1;fillColor=none;strokeColor=#1a1a1a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1230" y="226" width="28" height="28" as="geometry"/></mxCell><mxCell id="L_a1_in" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1236" y="232" width="16" height="16" as="geometry"/></mxCell><mxCell id="L_rB" value="&lt;b&gt;Região 2 — RecordedVideo / VOD (enum ProcessingStatus)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1240" height="420" as="geometry"/></mxCell><mxCell id="L_b0" value="" style="ellipse;html=1;fillColor=#1a1a1a;strokeColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="270" y="622" width="20" height="20" as="geometry"/></mxCell><mxCell id="L_REC_PROC" value="&lt;b style=&quot;font-size:13px&quot;&gt;PROCESSING&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #d79b00;margin:4px 6px 0 6px;padding-top:3px;font-size:10px;text-align:left;line-height:13px&quot;&gt;do / persistRecording(streamId)&lt;br&gt;availableAt ainda indefinido&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140" y="660" width="280" height="80" as="geometry"/></mxCell><mxCell id="L_REC_READY" value="&lt;b style=&quot;font-size:13px&quot;&gt;READY&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #d79b00;margin:4px 6px 0 6px;padding-top:3px;font-size:10px;text-align:left;line-height:13px&quot;&gt;entry / availableAt := now&lt;br&gt;entry / publica RecordingAvailable&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="660" width="280" height="80" as="geometry"/></mxCell><mxCell id="L_REC_FAIL" value="&lt;b style=&quot;font-size:13px&quot;&gt;FAILED&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #d79b00;margin:4px 6px 0 6px;padding-top:3px;font-size:10px;text-align:left;line-height:13px&quot;&gt;entry / publica RecordingFailed(reason)&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="540" y="870" width="280" height="64" as="geometry"/></mxCell><mxCell id="L_REC_EXP" value="&lt;b style=&quot;font-size:13px&quot;&gt;EXPIRED&lt;/b&gt;&lt;div style=&quot;border-top:1px solid #d79b00;margin:4px 6px 0 6px;padding-top:3px;font-size:10px;text-align:left;line-height:13px&quot;&gt;gravação além da retenção&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=center;spacingTop=5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="95